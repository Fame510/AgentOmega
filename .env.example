# Browser
HEADLESS=true
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=720
DEFAULT_TIMEOUT_MS=5000

# LLM / VLM (Ollama by default)
PLANNER_LLM_URL=http://localhost:11434/api/generate
PLANNER_MODEL=llama3.2
VLM_URL=http://localhost:11434/api/generate
VLM_MODEL=llava

# Execution
MAX_STEPS=20
MAX_RETRIES_PER_ACTION=3

# Redis (optional)
REDIS_URL=redis://localhost:6379
USE_REDIS_SESSION=false

# Firecrawl (optional)
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=https://api.firecrawl.dev/v1

# ---- SHACKLE governor ----
SHACKLE_BUDGET_USD=1.0
SHACKLE_MAX_REPEAT_CALLS=3
SHACKLE_ERROR_AMPLIFICATION=true
SHACKLE_MAX_TOTAL_CALLS=200
# hitl_mode: never | on_deny | on_threshold | always
SHACKLE_HITL_MODE=on_threshold
SHACKLE_HITL_BUDGET_THRESHOLD=0.15
SHACKLE_HITL_TIMEOUT_S=120
SHACKLE_AUDIT_PATH=./data/audit.jsonl
# Optional 64-hex-char Ed25519 seed; generated if empty
SHACKLE_SIGNING_KEY_HEX=
# Bearer token required for /api/* governance endpoints (fails closed if empty)
SHACKLE_API_TOKEN=
